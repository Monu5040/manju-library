# Local development settings. `make setup` copies this file to backend/.env.

ENVIRONMENT=development

# Matches docker-compose.yml at the repository root.
DATABASE_URL=postgres://manju:manju@localhost:5432/manju
REDIS_URL=redis://localhost:6379/0

# In development, student login codes are printed in the Django log instead of sent by SMS.
SMS_BACKEND=core.sms.ConsoleSMSBackend
