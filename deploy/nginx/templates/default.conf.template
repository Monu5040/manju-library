# Rendered at container start; ${SERVER_NAME} comes from the environment.

# Docker's own DNS, asked again every 10 seconds: when the backend container is replaced
# (a settings change, a crash), nginx finds its new address instead of holding on to the
# old one and answering 502 until nginx itself restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream django {
    zone django 64k;
    server backend:8000 resolve;
    keepalive 16;
}

# Back-office sign-in: 5 tries a minute per address. Each try runs a deliberately slow
# password hash, so without a limit it is both a guessing door and a way to stall the site.
limit_req_zone $binary_remote_addr zone=backoffice_login:1m rate=5r/m;
limit_req_status 429;

# Access log without query strings (a search can hold a mobile number) or referrers.
log_format noquery '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent $request_time "$http_user_agent"';
access_log /var/log/nginx/access.log noquery;

# Requests for any other host name get no answer.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    # Let's Encrypt renewals.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Mozilla "intermediate": forward-secret AEAD suites only for TLS 1.2.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Matches the 10 MB limit for Excel and CSV imports.
    client_max_body_size 10m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Django sets its own security headers on these responses.
    location /api/ {
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /backoffice/login/ {
        limit_req zone=backoffice_login burst=5 nodelay;
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /backoffice/ {
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /static/ {
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Built React files have content hashes in their names, so they can be cached for a year.
    location /assets/ {
        root /usr/share/nginx/html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Every other path is a page of the React app.
    location / {
        root /usr/share/nginx/html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
