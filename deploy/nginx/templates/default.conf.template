# Rendered at container start; ${SERVER_NAME} comes from the environment.

upstream django {
    server backend:8000;
    keepalive 16;
}

# Requests for any other host name get no answer.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    # Let's Encrypt renewals.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Matches the 10 MB limit for Excel and CSV imports.
    client_max_body_size 10m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Django sets its own security headers on these responses.
    location /api/ {
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /backoffice/ {
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /static/ {
        proxy_pass http://django;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Built React files have content hashes in their names, so they can be cached for a year.
    location /assets/ {
        root /usr/share/nginx/html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Every other path is a page of the React app.
    location / {
        root /usr/share/nginx/html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
