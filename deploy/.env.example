# Staging or production settings. Copy to deploy/.env on the server and fill in every value.
# Never commit the real file. Keep comments on their own lines.

# staging or production
ENVIRONMENT=production

# Compose files for this server. To run PostgreSQL on the VM instead of a managed database:
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.db.yml
COMPOSE_FILE=docker-compose.prod.yml

# Public host name. No domain yet? <ip-with-dashes>.sslip.io resolves to the IP,
# for example 151-185-44-63.sslip.io, and works with Let's Encrypt.
SERVER_NAME=library.example.com
# Optional contact email for Let's Encrypt; leave empty to register without one.
LETSENCRYPT_EMAIL=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=library.example.com
CSRF_TRUSTED_ORIGINS=https://library.example.com
# Nginx is the one proxy in front of Django.
NUM_PROXIES=1

# Managed PostgreSQL. Keep sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/manju?sslmode=require
# PostgreSQL on the VM (docker-compose.db.yml) instead:
# POSTGRES_PASSWORD=<long random value>
# DATABASE_URL=postgres://manju:<same password>@db:5432/manju
REDIS_URL=redis://redis:6379/0

# Generate with: docker compose -f docker-compose.prod.yml run --rm backend python manage.py generate_encryption_key
# Store a copy in a password manager: without it, encrypted Aadhaar numbers cannot be read.
FIELD_ENCRYPTION_KEYS=

# SMS for student login codes: MSG91, with a DLT-approved sender ID and OTP template.
SMS_BACKEND=core.sms.Msg91SMSBackend
MSG91_AUTH_KEY=
# The template's ID in MSG91 (SMS -> Templates), and the template's variable for the code.
MSG91_OTP_TEMPLATE_ID=
MSG91_CODE_VARIABLE=otp
# Only if the template also has a variable for "expires in N minutes":
# MSG91_MINUTES_VARIABLE=minutes
# Automatic reminders: one DLT-approved template per kind (leave empty to send that kind by
# WhatsApp from the Reminders page instead). Templates receive the variables name, library,
# date, seat, shift and amount; then turn on "Send by SMS" in Settings.
# MSG91_TEMPLATE_EXPIRING_SOON=
# MSG91_TEMPLATE_EXPIRES_TODAY=
# MSG91_TEMPLATE_DUES=
# MSG91_TEMPLATE_WAITLIST=
# Staging only, until the SMS provider is ready: login codes go to the server log.
# SMS_BACKEND=core.sms.ConsoleSMSBackend
# SMS_CONSOLE_ALLOWED=true
# Testing without SMS: these mobile numbers (comma-separated) see their login code on the
# sign-in screen. Staging only; a production deploy refuses it.
# LOGIN_CODE_ON_SCREEN=9876543210

# Online payments (optional): Razorpay. Set all three or none, then turn it on in Settings.
# Test keys (rzp_test_...) move no real money; production refuses them. See README,
# "Online payments". The webhook secret is any long random string, also entered in the
# Razorpay dashboard for the webhook https://<your-domain>/api/payments/razorpay/webhook/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# With test keys, only these mobile numbers (comma-separated) can pay online, so test money
# never gives a real student a receipt or a renewal. Not needed with live keys.
RAZORPAY_TEST_MOBILES=

# Error monitoring (optional but recommended).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO

# Database backups to S3-compatible object storage (deploy/backup).
BACKUP_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
